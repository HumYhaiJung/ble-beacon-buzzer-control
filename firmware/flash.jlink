# J-Link Commander script for flashing DA14531
# Usage: JLinkExe -device DA14531 -if SWD -speed 4000 -CommanderScript flash.jlink

# Connect to device
si SWD
speed 4000
device DA14531

# Erase flash
erase

# Load hex file
loadfile build/ble_beacon_buzzer_control.hex

# Verify
verifybin build/ble_beacon_buzzer_control.hex 0

# Reset and run
r
g

# Exit
qc
